# =======================
# ZMQ (control plane)
# =======================
# Control API PUSH bind (api_process.py connects here)
ZMQ_BIND_PULL_INTENT_HOST=0.0.0.0
ZMQ_BIND_PULL_INTENT_PORT=6000

# UDP publisher PULL connect (udp_publisher.py connects here)
# Must match whatever api_process uses for its PUSH->PULL wiring.
# ZMQ_PULL legacy removed; use ZMQ_BIND_PULL_INTENT_* instead.


# =======================
# GCS internal/bind ports
# =======================
# These are the ports the processes bind to INSIDE the container (and on the host in run.sh --network host mode).
RTP_RX_LISTEN_PORT=5004
RTP_RX_SHM_NAME=client_rtp_rx_shm
MAX_JPEG_BYTES=8000000
ZMQ_BIND_PUB_FRAME_HOST=0.0.0.0
ZMQ_BIND_PUB_FRAME_PORT=5572

# =======================
# Control intents: GCS -> Gateway (UDP)
# =======================
# Destination for UDP intents (RTP_SUBSCRIBE, RTP_SET_PARAMS, PIXEL_CLICK, etc.)
# This should be the Gateway’s UDP listener address (often the gateway MACVLAN/LAN IP at that site).
#
# NOTE (compose-local): you should override this in docker-compose.yml with:
#   UDP_INTENT_DST_IP=gateway
# so containers talk over the vision network without hairpin/macvlan weirdness.
UDP_INTENT_DST_IP=192.168.1.50
UDP_INTENT_DST_PORT=9000


# =======================
# Meta: Gateway -> GCS (UDP), then into API via ZMQ
# =======================
# If you want /link_usage, FRAME_META, etc. to populate, GCS must listen for meta.
# Format: name:port[,name:port...]
UDP_RX_BINDINGS=meta:9100,imu:9101,telem:9102

# =======================
# Local telemetry PUB (UDP RX -> ZMQ)
# =======================
ZMQ_BIND_PUB_TELEM_HOST=0.0.0.0
ZMQ_BIND_PUB_TELEM_PORT=5570


# =======================
# Multi-NIC (Wi-Fi + Ethernet) safety
# =======================
# When you press "Stream Video", GCS advertises an IP address for the gateway to send RTP back to.
# If your machine has multiple NICs, the auto-pick may choose Wi-Fi. To force the correct return IP:
# Work Desktop
GCS_IP=192.168.1.46

# Nano
#GCS_IP=192.168.1.10
