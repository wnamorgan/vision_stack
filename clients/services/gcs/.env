# =======================
# ZMQ (control plane)
# =======================
# Control API PUSH connect (api_process.py connects here)
ZMQ_CONNECT_PUSH_INTENT_HOST=gateway
ZMQ_CONNECT_PUSH_INTENT_PORT=6000

# UDP publisher PULL connect (udp_publisher.py connects here)
# Must match whatever api_process uses for its PUSH->PULL wiring.
# ZMQ_PULL legacy removed; use ZMQ_CONNECT_PUSH_INTENT_* instead.

# Meta SUB (api_process.py) from gateway UDP RX PUB
ZMQ_CONNECT_SUB_TELEM_HOST=gateway
ZMQ_CONNECT_SUB_TELEM_PORT=5570


# =======================
# GCS internal/bind ports
# =======================
# These are the ports the processes bind to INSIDE the container (and on the host in run.sh --network host mode).
RTP_RX_LISTEN_PORT=5004
MAX_JPEG_BYTES=8000000
ZMQ_CONNECT_SUB_FRAME_HOST=gateway
ZMQ_CONNECT_SUB_FRAME_PORT=5572

HTTP_BIND_VIDEO_PORT=8000
HTTP_BIND_CONTROL_PORT=8100
HTTP_BIND_DASH_PORT=8081
HTTP_BIND_VIDEO_HOST=0.0.0.0
HTTP_BIND_CONTROL_HOST=0.0.0.0
HTTP_BIND_DASH_HOST=0.0.0.0
HTTP_PUBLIC_HOST=127.0.0.1
HTTP_PUBLIC_VIDEO_PORT=8000
HTTP_PUBLIC_CONTROL_PORT=8100
STATIC_DIR=/app/static


# =======================
# Control intents: GCS -> Gateway (UDP)
# =======================
# Destination for UDP intents (RTP_SUBSCRIBE, RTP_SET_PARAMS, PIXEL_CLICK, etc.)
# This should be the Gateway’s UDP listener address (often the gateway MACVLAN/LAN IP at that site).
#
# NOTE (compose-local): you should override this in docker-compose.yml with:
#   UDP_INTENT_DST_IP=gateway
# so containers talk over the vision network without hairpin/macvlan weirdness.
UDP_INTENT_DST_IP=gateway
UDP_INTENT_DST_PORT=9000


# =======================
# LOCAL_IP
# =======================
# LOCAL_IP is the host/LAN IP this client advertises for UDP/RTP return traffic.
# Set this once (e.g., via docker-compose environment override) so all services use the same value.
# If you have multiple NICs, pick the IP the gateway can reach.
# Work Desktop
LOCAL_IP=192.168.1.46

# Nano
#LOCAL_IP=192.168.1.10
