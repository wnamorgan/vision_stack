SHM_NAME=vision_camera_frame_shm
MAX_WIDTH=7680
MAX_HEIGHT=4320
CHANNELS=3
ZMQ_BIND_PUB_CAMERA_HOST=0.0.0.0
ZMQ_BIND_PUB_CAMERA_PORT=5555

# Gateway intent destination for frame registration
GW_INTENT_DST_IP=gateway
GW_INTENT_DST_PORT=9000
GW_REGISTER_SUB_HOST=camera
GW_REGISTER_SUB_PORT=5555
GW_REGISTER_INTENT_TYPE=GW_REGISTER_FRAME_ZMQ_SUB

# Gateway cmd bus (heartbeat)
ZMQ_CONNECT_SUB_CMD_HOST=gateway
ZMQ_CONNECT_SUB_CMD_PORT=5561

CAM_WIDTH=1280
CAM_HEIGHT=720
CAM_FPS=120
CAM_DEVICE=/dev/video0

CAMERA_IMAGE=vision_stack-camera
