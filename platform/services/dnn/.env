# DNN publishes detections (ZMQ) for whoever consumes them next (gateway or SOT later)
ZMQ_BIND_PUB_DET_HOST=0.0.0.0
ZMQ_BIND_PUB_DET_PORT=5566
ZMQ_DET_TOPIC=detections

# Model selection
#DNN_MODEL_NAME=yolo11n_toy_cars_190.pt
DNN_MODEL_NAME=yolov8n.pt
DNN_CONF_THRESH=0.75

# Optional: initial hard-coded tiling/ROI until you plumb control messages
ROI_NORM=0,0,1,1
TILES=1,1
OVERLAP=0.0,0.0

# Tracker state machine
ZMQ_BIND_PUB_TRACKER_HOST=0.0.0.0
ZMQ_BIND_PUB_TRACKER_PORT=5580
ZMQ_CONNECT_SUB_INTENT_HOST=gateway
ZMQ_CONNECT_SUB_INTENT_PORT=5560
TRACKER_HEARTBEAT_HZ=10
