# IMU Baud Rate
IMU_BAUD=921600

# Collect this information with the following bash command: udevadm info -q property -n /dev/ttyUSB0
USB_VENDOR=0403
USB_PRODUCT=6015
USB_SERIAL=D30FJZ4X

# What to stream / publish (your run_imu.py can interpret these)
IMU_STREAM_TYPE=GAA
IMU_PUB_HZ=0          # 0 = as-fast-as-arrives

# ZMQ publish endpoint (gateway will SUB this internally)
ZMQ_BIND_PUB_IMU_HOST=0.0.0.0
ZMQ_BIND_PUB_IMU_PORT=5530
ZMQ_IMU_TOPIC=imu

# Gateway intent destination for ZMQ endpoint registration
GW_INTENT_DST_IP=gateway
GW_INTENT_DST_PORT=9000
GW_REGISTER_SUB_HOST=imu
GW_REGISTER_SUB_PORT=5530
GW_REGISTER_STREAM=imu

# Gateway cmd bus (heartbeat)
ZMQ_CONNECT_SUB_CMD_HOST=gateway
ZMQ_CONNECT_SUB_CMD_PORT=5561

LOG_LEVEL=INFO
