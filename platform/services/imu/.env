# IMU Baud Rate
IMU_BAUD=921600

# Collect this information with the following bash command: udevadm info -q property -n /dev/ttyUSB0
USB_VENDOR=0403
USB_PRODUCT=6015
USB_SERIAL=D30FJZ4X

# What to stream / publish (your run_imu.py can interpret these)
IMU_STREAM_TYPE=GAA
IMU_PUB_HZ=0          # 0 = as-fast-as-arrives

# ZMQ publish endpoint (gateway will SUB this internally)
ZMQ_BIND_PUB_IMU_HOST=0.0.0.0
ZMQ_BIND_PUB_IMU_PORT=5530
ZMQ_IMU_TOPIC=imu
